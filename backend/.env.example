# Server
PORT=5000
NODE_ENV=development

# Database (Supabase Postgres or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/schoolhub?schema=public"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Frontend origins (comma-separated) allowed by CORS in production
FRONTEND_URL=http://localhost:5173

# SMS gateway (Arkesel-compatible). Leave empty to disable SMS delivery.
SMS_API_KEY=
SMS_SENDER_ID=SchoolHub
SMS_API_URL=https://sms.arkesel.com/api/v2/sms/send
