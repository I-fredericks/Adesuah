generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Platform & tenancy
// ────────────────────────────────────────────────────────────────────────

model School {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  shortName    String?
  logoUrl      String?
  motto        String?
  address      String?
  city         String?
  region       String?
  phone        String?
  email        String?
  gesRegNumber String?

  // SaaS subscription (billing arrives in a later phase; fields ready now)
  plan               Plan               @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  isActive           Boolean            @default(true)

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  academicYears   AcademicYear[]
  terms           Term[]
  levels          Level[]
  classes         SchoolClass[]
  subjects        Subject[]
  classSubjects   ClassSubject[]
  assessmentTypes AssessmentType[]
  gradingScales   GradingScale[]
  students        Student[]
  enrollments     Enrollment[]
  attendance      AttendanceRecord[]
  scores          Score[]
  reportCards     ReportCard[]
  feeStructures   FeeStructure[]
  invoices        Invoice[]
  payments        Payment[]
  announcements   Announcement[]
  notifications   Notification[]
  rolePermissions RolePermission[]
  messageLogs     MessageLog[]
  auditLogs       AuditLog[]
  corrections     ResultCorrection[]
  staffAttendance StaffAttendance[]
  salaryPayments  SalaryPayment[]
  extraClasses    ExtraClass[]
  assignments     Assignment[]

  @@map("school")
}

model User {
  id             Int     @id @default(autoincrement())
  schoolId       Int?
  school         School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email          String? @unique
  phone          String? @unique
  password       String
  name           String
  avatarUrl      String?
  role           Role    @default(TEACHER)
  isActive       Boolean @default(true)
  lastLoginAt    DateTime?
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffProfile      StaffProfile?
  taughtSubjects    ClassSubject[]
  markedAttendance  AttendanceRecord[]
  enteredScores     Score[]
  announcements     Announcement[]
  notifications     Notification[]
  guardianOf        Guardian[]
  paymentsRecorded  Payment[]
  classesLed        SchoolClass[]
  lockedReportCards ReportCard[]   @relation("ReportCardLocker")
  auditLogs         AuditLog[]
  salaryPayments    SalaryPayment[]
  salariesRecorded  SalaryPayment[] @relation("SalaryRecorder")
  extraClassesTaught ExtraClass[]
  assignmentsGiven  Assignment[]
  correctionsRequested ResultCorrection[] @relation("CorrectionRequester")
  correctionsDecided   ResultCorrection[] @relation("CorrectionDecider")
  staffAttendance      StaffAttendance[]
  staffAttendanceMarked StaffAttendance[] @relation("StaffAttendanceMarker")
  extraClassesCreated  ExtraClass[]      @relation("ExtraClassCreator")
  assignmentsCreated   Assignment[]      @relation("AssignmentCreator")

  @@index([schoolId, role])
  @@map("user")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  HEADTEACHER
  DEPUTY_HEAD
  ACADEMIC_COORDINATOR
  TEACHER
  ACCOUNTANT
  SECRETARY
  SUPPORT_STAFF
  PARENT
}

// Per-school permission matrix: what each role may do. Seeded from code
// defaults at onboarding; schools with no rows fall back to the defaults.
model RolePermission {
  id         Int    @id @default(autoincrement())
  schoolId   Int
  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role       Role
  permission String

  @@unique([schoolId, role, permission])
  @@index([schoolId, role])
  @@map("rolepermission")
}

// Tamper-evident trail for sensitive actions: score edits, result corrections,
// payments, discounts, publish/lock, staff and permission changes.
model AuditLog {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after    Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, entity, entityId])
  @@map("auditlog")
}

// Teacher requests a score change (with reason); approver grants or rejects.
// Applied changes are written to Score and recorded in AuditLog.
model ResultCorrection {
  id               Int              @id @default(autoincrement())
  schoolId         Int
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId        Int
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId        Int
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId           Int
  term             Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  assessmentTypeId Int
  assessmentType   AssessmentType   @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  oldScore         Float
  newScore         Float
  reason           String
  status           CorrectionStatus @default(PENDING)
  requestedById    Int?
  requestedBy      User?            @relation("CorrectionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById      Int?
  decidedBy        User?            @relation("CorrectionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decisionNote     String?
  appliedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([schoolId, status])
  @@index([studentId, termId])
  @@map("resultcorrection")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Daily staff (teacher/admin) attendance register.
model StaffAttendance {
  id         Int              @id @default(autoincrement())
  schoolId   Int
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     Int
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById Int?
  markedBy   User?            @relation("StaffAttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([schoolId, date])
  @@map("staffattendance")
}

enum Plan {
  FREE
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model StaffProfile {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId     Int
  staffNo      String
  position     String?
  qualification String?
  hiredAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, staffNo])
  @@index([schoolId])
  @@map("staffprofile")
}

// ────────────────────────────────────────────────────────────────────────
// Academic structure
// ────────────────────────────────────────────────────────────────────────

model AcademicYear {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms       Term[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academicyear")
}

model Term {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           TermName
  startDate      DateTime
  endDate        DateTime
  vacationDate   DateTime?
  nextTermBegins DateTime?
  isCurrent      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeStructures FeeStructure[]
  scores        Score[]
  reportCards   ReportCard[]
  invoices      Invoice[]
  corrections   ResultCorrection[]
  assignments   Assignment[]

  @@unique([academicYearId, name])
  @@index([schoolId, isCurrent])
  @@map("term")
}

enum TermName {
  TERM_1
  TERM_2
  TERM_3
}

model Level {
  id       Int        @id @default(autoincrement())
  schoolId Int
  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?
  stage    LevelStage @default(PRIMARY)
  order    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes       SchoolClass[]
  gradingScales GradingScale[]

  @@unique([schoolId, name])
  @@index([schoolId, order])
  @@map("level")
}

enum LevelStage {
  KG
  PRIMARY
  JHS
}

model SchoolClass {
  id              Int     @id @default(autoincrement())
  schoolId        Int
  school          School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  levelId         Int
  level           Level   @relation(fields: [levelId], references: [id])
  name            String
  capacity        Int?
  classTeacherId  Int?
  classTeacher    User?   @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects       ClassSubject[]
  students       Student[]
  enrollments    Enrollment[]
  attendance     AttendanceRecord[]
  scores         Score[]
  announcements  Announcement[]
  extraClasses   ExtraClass[]
  assignments    Assignment[]
  feeStructures  FeeStructure[]
  @@unique([schoolId, name])
  @@index([schoolId, levelId])
  @@map("schoolclass")
}

model Subject {
  id       Int     @id @default(autoincrement())
  schoolId Int
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?
  isCore   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  scores        Score[]
  corrections   ResultCorrection[]
  extraClasses  ExtraClass[]
  assignments   Assignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subject")
}

model ClassSubject {
  id        Int      @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   Int
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId Int?
  teacher   User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@map("classsubject")
}

model AssessmentType {
  id           Int     @id @default(autoincrement())
  schoolId     Int
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  shortCode    String?
  weight       Float
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores      Score[]
  corrections ResultCorrection[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("assessmenttype")
}
model GradingScale {
  id         Int        @id @default(autoincrement())
  schoolId   Int
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  levelId    Int?
  level      Level?     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  grade      String
  minScore   Float
  maxScore   Float
  descriptor String?
  remark     String?
  order      Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, levelId, grade])
  @@index([schoolId])
  @@map("gradingscale")
}

// ────────────────────────────────────────────────────────────────────────
// Students & enrollment
// ────────────────────────────────────────────────────────────────────────

model Student {
  id            Int           @id @default(autoincrement())
  schoolId      Int
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo   String
  firstName     String
  lastName      String
  otherNames    String?
  gender        Gender
  dateOfBirth   DateTime?
  photoUrl      String?
  address       String?
  healthNotes   String?
  status        StudentStatus @default(ACTIVE)
  currentClassId Int?
  currentClass  SchoolClass?  @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  enrolledAt    DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians   Guardian[]
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  scores      Score[]
  reportCards ReportCard[]
  invoices    Invoice[]
  corrections ResultCorrection[]

  messageLogs   MessageLog[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
  @@index([currentClassId])
  @@map("student")
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

model Guardian {
  id           Int                  @id @default(autoincrement())
  studentId    Int
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  relationship GuardianRelationship @default(GUARDIAN)
  phone        String
  whatsapp     String?
  email        String?
  occupation   String?
  isPrimary    Boolean              @default(false)
  userId       Int?
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([phone])
  @@map("guardian")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Enrollment {
  id             Int              @id @default(autoincrement())
  schoolId       Int
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        Int
  class          SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId Int
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, classId])
  @@map("enrollment")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
}

// ────────────────────────────────────────────────────────────────────────
// Attendance
// ────────────────────────────────────────────────────────────────────────

model AttendanceRecord {
  id          Int              @id @default(autoincrement())
  schoolId    Int
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId     Int
  class       SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus
  reason      String?
  markedById  Int?
  markedBy    User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, classId, date])
  @@map("attendancerecord")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ────────────────────────────────────────────────────────────────────────
// Assessments & report cards
// ────────────────────────────────────────────────────────────────────────

model Score {
  id               Int            @id @default(autoincrement())
  schoolId         Int
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId        Int
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId        Int
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId          Int
  class            SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId           Int
  term             Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  assessmentTypeId Int
  assessmentType   AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  rawScore         Float
  enteredById      Int?
  enteredBy        User?          @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId, assessmentTypeId])
  @@index([schoolId, termId, classId, subjectId])
  @@map("score")
}

model ReportCard {
  id             Int      @id @default(autoincrement())
  schoolId       Int
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        Int
  termId         Int
  term           Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  totalScore     Float
  average        Float
  classPosition  Int
  subjectsCount  Int
  daysPresent    Int
  daysOpened     Int
  subjects       Json
  teacherRemark  String?
  headRemark     String?
  conduct        String?
  interest       String?
  talent         String?
  promoted       Boolean?
  promotedTo     String?
  published      Boolean  @default(false)
  publishedAt    DateTime?
  locked         Boolean  @default(false)
  lockedAt       DateTime?
  lockedById     Int?
  lockedBy       User?    @relation("ReportCardLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([schoolId, termId, classId])
  @@map("reportcard")
}

// ────────────────────────────────────────────────────────────────────────
// Fees
// ────────────────────────────────────────────────────────────────────────

model FeeStructure {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId Int
  termId         Int
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  classId        Int
  class          SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String       @default("Term fees")
  totalAmount    Decimal      @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    FeeItem[]
  invoices Invoice[]

  @@unique([termId, classId])
  @@index([schoolId, termId])
  @@map("feestructure")
}

model FeeItem {
  id           Int     @id @default(autoincrement())
  structureId  Int
  structure    FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([structureId])
  @@map("feeitem")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  schoolId       Int
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId         Int
  term           Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  structureId    Int?
  structure      FeeStructure? @relation(fields: [structureId], references: [id], onDelete: SetNull)
  amountTotal    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime?
  lastRemindedAt DateTime?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        InvoiceItem[]
  payments     Payment[]
  installments InvoiceInstallment[]

  @@unique([studentId, termId])
  @@index([schoolId, termId, status])
  @@map("invoice")
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoiceitem")
}

// Expected payment schedule for an invoice; payments are allocated across
// instalments in due-date order to compute per-instalment balances.
model InvoiceInstallment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  amount    Decimal  @db.Decimal(12, 2)
  label     String?  @default("Instalment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, dueDate])
  @@map("invoiceinstallment")
}

model Payment {
  id           Int           @id @default(autoincrement())
  schoolId     Int
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId    Int
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  receiptNo    String?       @unique
  paidAt       DateTime      @default(now())
  recordedById Int?
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, paidAt])
  @@index([invoiceId])
  @@map("payment")
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

enum PaymentMethod {
  CASH
  MOMO
  BANK
  CHEQUE
  OTHER
}

// ────────────────────────────────────────────────────────────────────────
// Communication
// ────────────────────────────────────────────────────────────────────────

model Announcement {
  id          Int        @id @default(autoincrement())
  schoolId    Int
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId    Int?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  classId     Int?
  class       SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  title       String
  body        String
  audience    Audience   @default(ALL)
  isPinned    Boolean    @default(false)
  smsSent     Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, createdAt])
  @@map("announcement")
}

enum Audience {
  ALL
  STAFF
  CLASS
}

model Notification {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

// ────────────────────────────────────────────────────────────────────────
// Payroll, extra classes, assignments
// ────────────────────────────────────────────────────────────────────────

// Light payroll: one salary record per staff per period (e.g. "2026-10").
// Staff see their own records; finance/head see everyone's.
model SalaryPayment {
  id           Int           @id @default(autoincrement())
  schoolId     Int
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  period       String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(MOMO)
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  recordedById Int?
  recordedBy   User?         @relation("SalaryRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, period])
  @@index([schoolId, period])
  @@map("salarypayment")
}

// Head-managed extra classes (e.g. morning classes): can be modified,
// paused or terminated at any time.
model ExtraClass {
  id          Int               @id @default(autoincrement())
  schoolId    Int
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  classId     Int
  class       SchoolClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   Int?
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId   Int?
  teacher     User?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  days        String
  startTime   String
  endTime     String
  venue       String?
  startDate   DateTime          @default(now())
  endDate     DateTime?
  status      ExtraClassStatus  @default(ACTIVE)
  notes       String?
  createdById Int?
  createdBy   User?             @relation("ExtraClassCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@map("extraclass")
}

enum ExtraClassStatus {
  ACTIVE
  PAUSED
  ENDED
}

// Homework / assignments given by teachers; visible to parents in the portal.
model Assignment {
  id           Int       @id @default(autoincrement())
  schoolId     Int
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      Int
  class        SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId    Int?
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId    Int?
  teacher      User?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  termId       Int
  term         Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime?
  createdById  Int?
  createdBy    User?     @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, classId, termId])
  @@map("assignment")
}

// Every outbound SMS/WhatsApp with delivery status — the message log page.
model MessageLog {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  channel   String   @default("sms")
  recipient String
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  message   String
  status    String   @default("logged")
  response  String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@map("messagelog")
}
